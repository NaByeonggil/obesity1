# obesity.ai.kr HTTPS 리버스 프록시 (Let's Encrypt 인증서 자동 발급/갱신)

{
	# ACME 계정 연락처 (.env.caddy 의 ACME_EMAIL)
	email {$ACME_EMAIL}
}

obesity.ai.kr {
	encode zstd gzip

	# 클라이언트 요청 크기 제한 (파일 업로드용)
	request_body {
		max_size 10MB
	}

	# 보안 헤더
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
	}

	# Next.js 애플리케이션으로 프록시
	reverse_proxy app:3000
}

www.obesity.ai.kr {
	redir https://obesity.ai.kr{uri} permanent
}

# YouTube 자동화 앱 (~/바탕화면/youtube, docker-compose.local.yml 의 youtube-app 서비스)
youtube.obesity.ai.kr {
	encode zstd gzip

	reverse_proxy youtube-app:3001
}

# 사업계획서 에디터 (~/바탕화면/money, docker-compose.production.yml 의 money-app 서비스)
# 앱 자체에 인증이 없어 누구나 수정·초기화할 수 있으므로 Basic 인증으로 막는다.
# 비밀번호 변경: caddy hash-password 로 만든 해시를 .env.caddy 의 MONEY_AUTH_HASH 에 넣고 caddy 재생성
money.obesity.ai.kr {
	encode zstd gzip

	basic_auth {
		nbg {$MONEY_AUTH_HASH}
	}

	reverse_proxy money-app:3000
}
